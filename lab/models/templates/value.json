 "id": "template-value",
 "family_id": "template-value",
 "name": "價值(範本)",
 "based_on": "jw-mf-2.0@84220996991ad8b6",
 "created": "2026-11-02",
 "notes": "範本是起點,沒有證實有效。權重在 2026-11-02 依文獻與常識事先決定,寫進範本後才准跑回測;不得看回測結果回頭調。",
 "template": {
  "id": "value",
  "order": 2,
  "markets": [
   "TW",
   "US"
  ],
  "title": {
   "zh-TW": "價值"
  },
  "for_whom": {
   "zh-TW": "重視估值、願意長期等待的人"
  },
  "focus": {
   "zh-TW": "估值為主、財務安全次之"
  },
  "ignores": {
   "zh-TW": "不看短期漲跌與分析師預期修正"
  },
  "rationale": {
   "zh-TW": "價值溢酬是最早被記錄的因子之一(Fama–French 的 HML);Graham 主張買價低於價值並要求財務穩健,便宜股裡財務差的常是價值陷阱,所以財務安全次之、品質再次之(Piotroski 的做法)。估值裡加重現金流殖利率與 EV/EBITDA 這類以現金流、企業價值計算的倍數(LSV 用 CF/P;Loughran–Wellman 用 EBITDA/EV)。"
  },
  "sources": [
   "Fama & French (1992), The Cross-Section of Expected Stock Returns, Journal of Finance",
   "Graham (1949), The Intelligent Investor",
   "Lakonishok, Shleifer & Vishny (1994), Contrarian Investment, Extrapolation, and Risk, Journal of Finance",
   "Loughran & Wellman (2011), New Evidence on the Relation between the Enterprise Multiple and Average Stock Returns, JFQA",
   "Piotroski (2000), Value Investing: The Use of Historical Financial Statement Information, Journal of Accounting Research"
  ],
  "requires_vars": []
 },
 "pillar_weights": {
