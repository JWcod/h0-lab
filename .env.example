# 複製成 .env 後填入(.env 不會進 git)
# SEC 要求宣告 User-Agent(英文名稱 + 聯絡信箱);不填就不連 SEC,美股財報會缺
SEC_USER_AGENT=
# FinMind 免費註冊後可拿 token,額度較高(不填也能用免費額度)
FINMIND_TOKEN=
# 伺服器只綁本機,不要改成 0.0.0.0
INVEST_LAB_HOST=127.0.0.1
INVEST_LAB_PORT=8765
# 新版本檢查:開啟網站時每天最多查一次 GitHub Releases(不帶任何個人資料);設成 0 就完全不連線
# INVEST_LAB_UPDATE_CHECK=0
